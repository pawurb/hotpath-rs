services:
  postgres:
    image: postgres:17
    ports:
      # Non-default host port so a system-wide postgres (or another project's
      # container) on 5432 doesn't collide.
      - "5439:5432"
    environment:
      POSTGRES_USER: hotpath
      POSTGRES_PASSWORD: hotpath
      POSTGRES_DB: hotpath
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U hotpath"]
      interval: 2s
      timeout: 2s
      retries: 15
  redis:
    image: redis:7
    ports:
      # Non-default host port so a system-wide redis on 6379 doesn't collide.
      - "6390:6379"
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 2s
      timeout: 2s
      retries: 15
  prometheus:
    image: prom/prometheus:v3.14.0
    ports:
      # Loopback-only, non-default host port so a system-wide prometheus on 9090
      # doesn't collide and network peers cannot query the scraped data.
      - "127.0.0.1:9099:9090"
    volumes:
      - ./docker/prometheus.yml:/etc/prometheus/prometheus.yml:ro
    extra_hosts:
      # Reach the hotpath exporter on the host from inside the container (needed
      # on Linux; Docker Desktop provides host.docker.internal out of the box).
      - "host.docker.internal:host-gateway"
  prometheus-legacy:
    # Prometheus 2.x has no native-histogram support: it scrapes the text
    # format and ingests only the classic fallback buckets, for comparing the
    # two representations side by side.
    image: prom/prometheus:v2.53.0
    ports:
      - "9098:9090"
    volumes:
      - ./docker/prometheus-legacy.yml:/etc/prometheus/prometheus.yml:ro
    extra_hosts:
      - "host.docker.internal:host-gateway"
  grafana:
    image: grafana/grafana:12.2.0
    ports:
      # Loopback-only (anonymous Admin access): 3000 is taken by `just docs`.
      - "127.0.0.1:3009:3000"
    environment:
      # Local-only demo stack, skip the login screen.
      GF_AUTH_ANONYMOUS_ENABLED: "true"
      GF_AUTH_ANONYMOUS_ORG_ROLE: Admin
      GF_AUTH_DISABLE_LOGIN_FORM: "true"
    volumes:
      - ./docker/grafana/provisioning:/etc/grafana/provisioning:ro
      - ./docker/grafana/dashboards:/var/lib/grafana/dashboards:ro
    depends_on:
      - prometheus
