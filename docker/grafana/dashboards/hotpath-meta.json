{
  "title": "hotpath-meta functions",
  "uid": "hotpath-functions-meta",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "function",
        "label": "function",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "hotpath-prom-meta" },
        "query": "label_values(hotpath_function_calls_total, function)",
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Function p99 latency (1m window)",
      "datasource": { "type": "prometheus", "uid": "hotpath-prom-meta" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le, function) (rate(hotpath_function_duration_seconds_bucket[1m])))",
          "legendFormat": "{{function}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Function call rate (1m window)",
      "datasource": { "type": "prometheus", "uid": "hotpath-prom-meta" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "expr": "rate(hotpath_function_calls_total[1m])",
          "legendFormat": "{{function}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Function average latency (1m window)",
      "datasource": { "type": "prometheus", "uid": "hotpath-prom-meta" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 9 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "rate(hotpath_function_duration_seconds_sum[1m]) / rate(hotpath_function_duration_seconds_count[1m])",
          "legendFormat": "{{function}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "heatmap",
      "title": "Latency distribution: $function",
      "datasource": { "type": "prometheus", "uid": "hotpath-prom-meta" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 9 },
      "options": { "calculate": false, "yAxis": { "unit": "s" } },
      "targets": [
        {
          "expr": "sum by (le) (rate(hotpath_function_duration_seconds_bucket{function=~\"$function\"}[1m]))",
          "format": "heatmap",
          "legendFormat": "{{le}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Function p99 latency (native histograms, 1m window)",
      "datasource": { "type": "prometheus", "uid": "hotpath-prom-meta" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 18 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (function) (rate(hotpath_function_duration_seconds[1m])))",
          "legendFormat": "{{function}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "piechart",
      "title": "Share of total function time (since start)",
      "datasource": { "type": "prometheus", "uid": "hotpath-prom-meta" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 27 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "displayLabels": ["percent"],
        "legend": { "displayMode": "table", "placement": "right", "values": ["percent", "value"] },
        "tooltip": { "mode": "single" }
      },
      "targets": [
        {
          "expr": "hotpath_function_duration_seconds_sum",
          "legendFormat": "{{function}}",
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "% of total function time (1m window)",
      "datasource": { "type": "prometheus", "uid": "hotpath-prom-meta" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 27 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": { "fillOpacity": 30, "stacking": { "mode": "normal" } }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "100 * rate(hotpath_function_duration_seconds_sum[1m]) / on() group_left() sum(rate(hotpath_function_duration_seconds_sum[1m]))",
          "legendFormat": "{{function}}",
          "refId": "A"
        }
      ]
    }
  ]
}
