{
  "title": "hotpath sql / http / server legacy",
  "uid": "hotpath-web-legacy",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Server p99 latency (classic buckets) by route (1m window)",
      "datasource": {
        "type": "prometheus",
        "uid": "hotpath-prom-legacy"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le, route) (rate(hotpath_server_duration_seconds_bucket[1m])))",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Server request / error rate by route (1m window)",
      "datasource": {
        "type": "prometheus",
        "uid": "hotpath-prom-legacy"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(hotpath_server_requests_total[1m])",
          "legendFormat": "{{route}}",
          "refId": "A"
        },
        {
          "expr": "rate(hotpath_server_responses_total[1m]) > 0",
          "legendFormat": "{{route}} {{class}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "SQL / HTTP calls per scoped request (1m window)",
      "datasource": {
        "type": "prometheus",
        "uid": "hotpath-prom-legacy"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(hotpath_server_sql_calls_total[1m]) / rate(hotpath_server_scoped_requests_total[1m])",
          "legendFormat": "{{route}} SQL/req",
          "refId": "A"
        },
        {
          "expr": "rate(hotpath_server_http_calls_total[1m]) / rate(hotpath_server_scoped_requests_total[1m])",
          "legendFormat": "{{route}} HTTP/req",
          "refId": "B"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "HTTP client p99 latency (classic buckets) by endpoint (1m window)",
      "datasource": {
        "type": "prometheus",
        "uid": "hotpath-prom-legacy"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le, endpoint) (rate(hotpath_http_duration_seconds_bucket[1m])))",
          "legendFormat": "{{endpoint}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "HTTP client request / error rate by endpoint (1m window)",
      "datasource": {
        "type": "prometheus",
        "uid": "hotpath-prom-legacy"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (endpoint) (rate(hotpath_http_requests_total[1m]))",
          "legendFormat": "{{endpoint}}",
          "refId": "A"
        },
        {
          "expr": "sum by (endpoint) (rate(hotpath_http_errors_total[1m])) > 0",
          "legendFormat": "{{endpoint}} errors",
          "refId": "B"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "SQL p99 latency (classic buckets) by query (1m window)",
      "datasource": {
        "type": "prometheus",
        "uid": "hotpath-prom-legacy"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le, query) (rate(hotpath_sql_duration_seconds_bucket[1m])))",
          "legendFormat": "{{query}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "SQL query rate (1m window)",
      "datasource": {
        "type": "prometheus",
        "uid": "hotpath-prom-legacy"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 27
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (query) (rate(hotpath_sql_queries_total[1m]))",
          "legendFormat": "{{query}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "type": "table",
      "title": "SQL queries by route / source (total calls)",
      "datasource": {
        "type": "prometheus",
        "uid": "hotpath-prom-legacy"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 27
      },
      "targets": [
        {
          "expr": "hotpath_sql_queries_total",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true
            }
          }
        }
      ]
    }
  ]
}
